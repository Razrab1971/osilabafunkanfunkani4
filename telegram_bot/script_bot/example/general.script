// Комментарии
/* Многострочные комментарии */

// Перечень доступных ботов:
/*
ChatGPT(текст -> текст)
DeepSeek(текст -> текст)
*/

// Ключевые выражения:
/*
INPUT(текст) - первое слово, отсюда поступает ввод пользователя
OUTPUT(текст) - итоговый вывод
PRINT("текст") - вывод промежуточной информации
ADD("текст"% ) - добавляет контекст к следующему шагу

| - разделитель
\ - переход на новую строку
*/

// Пример
INPUT(текст) | ChatGPT(текст) | \
PRINT("ChatGPT завершил работу") | \
ADD("Опиши более красочно "%) | DeepSeek(текст) | \
OUTPUT(текст)